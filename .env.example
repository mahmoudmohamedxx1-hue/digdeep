# ── PostgreSQL (Prisma) ────────────────────────────────────────────────────
# digdeep stores jobs, events, sources, sections, and settings in PostgreSQL.
#
# LOCAL DEV (embedded Postgres, no install needed):
#   bun run pg:start        # boots a self-contained Postgres on :5433 (db/pgdata)
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5433/digdeep
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/digdeep"
#
# VERCEL HOSTING (Vercel Postgres):
#   1. Create a Postgres database in your Vercel project (Storage → Postgres).
#   2. Vercel auto-injects POSTGRES_URL / POSTGRES_PRISMA_URL into the app —
#      digdeep picks them up automatically (no code change needed).
#      You may also set DATABASE_URL to the pooled connection string
#      (…pgbouncer=true&connection_limit=1) in Project → Settings → Env Vars.
#   3. Push the schema once from your machine:
#        DATABASE_URL="<your-pooled-url>" bun run db:push
#   4. Deploy — `prisma generate` runs automatically on install (postinstall).

# ── Z.ai official API backstop (optional, server-side only) ─────────────────
# When ZAI_API_KEY is set, the official Z.ai API (glm-4.5-flash, free tier) is
# added as a backstop RIGHT BEHIND the keyless chain (LLM7 → Pollinations):
# keyless stays primary so every visitor can research with no keys and no
# shared-key quota; the backstop only fires when both keyless tiers are
# throttled, rescuing jobs instead of waiting out cooldowns.
#   - The key lives ONLY in this env var (Vercel Project → Settings → Env Vars);
#     it is never committed to the repo and never sent to the browser.
#   - ZAI_API_URL   — override the API base (default https://api.z.ai/api/paas/v4)
#   - ZAI_API_MODELS — comma-separated models (default glm-4.5-flash; note
#     glm-5.3-flash requires a paid balance)
# ZAI_API_KEY="your-zai-api-key"

# ── Operator console (POST /api/settings) ──────────────────────────────────
# Admin allowlist for the backend console: LLM pool endpoints, endpoint keys,
# and search-provider settings. Comma-separated emails, case-insensitive.
#   - Listed email + signed-in session → can save backend settings
#   - Everyone else → 403 (and with ADMIN_EMAILS unset, EVERYONE gets 403 —
#     fail-closed, the same posture as CRON_SECRET)
#   - Set it in Vercel → Project → Settings → Env Vars, then redeploy.
ADMIN_EMAILS="you@example.com"

# ── Email-code (OTP) sign-in via Supabase Auth (v3.5) ──────────────────────
# Real email verification: Supabase emails a 6-digit code, DigDeep verifies it
# and issues its own session. Password auth keeps working alongside; accounts
# created by a code have no password (they sign in with codes).
#   - FAIL-CLOSED: with either var unset, the email-code tab is hidden, and
#     the OTP endpoints answer 503 — a deployment can never half-work.
#   - Only the ANON (publishable) key is used, server-side — the same calls a
#     browser would make. Never put the service_role/secret key here.
#   - For 6-digit CODES (not a magic link), the project's "Magic Link" email
#     template must contain {{ .Token }} — scripts/supabase/bootstrap.sh sets
#     this up; see that script's header for the manual path.
# Set both in Vercel → Project → Settings → Env Vars, then redeploy.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<publishable/anon key>"
