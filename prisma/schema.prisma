generator client {
  provider = "prisma-client-js"
  // driver adapters + WASM query compiler: the ENGINE-FREE query path via
  // @prisma/adapter-d1 (Workers) / @prisma/adapter-better-sqlite3 (Node) —
  // required for Cloudflare Workers (no native binaries on workerd). CRITICAL:
  // driverAdapters ALONE still needs the Rust library engine in Prisma 6.x
  // (the adapter replaces only the connection layer); queryCompiler replaces
  // the engine with a WASM compiler that bundles fine into workerd.
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  // v3.9.0 — SQLITE DIALECT (single code path for every platform):
  //   * Cloudflare Workers (prod): D1 binding via @prisma/adapter-d1 (see src/lib/db.ts)
  //   * Node local dev / tests:    better-sqlite3 via @prisma/adapter-better-sqlite3
  // The schema is pure scalars (String/Int/Boolean/DateTime) — zero Json columns,
  // zero enums, zero PG-specific types — so the same models run on both engines.
  // D1 enforces FK constraints (incl. onDelete: Cascade) by default; the local
  // better-sqlite3 path sets PRAGMA foreign_keys = ON through a factory wrapper.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ResearchJob {
  id              String            @id @default(cuid())
  query           String
  threadId        String? // groups follow-up questions into one Perplexity-style thread
  status          String            @default("queued") // queued|planning|researching|critiquing|synthesizing|completed|failed|cancelled
  stage           String            @default("Initializing")
  progress        Int               @default(0)
  preset          String            @default("standard") // quick|standard|deep|exhaustive|custom
  mode            String            @default("research") // chat|quick|research — how the engine answered this turn
  court           Boolean           @default(false) // put the idea on trial: prosecutor + defense + jury of 12 + judge
  language        String            @default("English")
  modelPref       String            @default("auto") // auto|glm|pool
  domain          String            @default("general") // general|law|finance|medicine — P2-1 domain packs
  breadth         Int               @default(3)
  depth           Int               @default(2)
  maxSources      Int               @default(18)
  maxMinutes      Int               @default(30)
  reportMd        String?
  plan            String? // JSON research plan
  stats           String? // JSON final stats
  docs            String? // JSON [{name, text}] — user-attached ground-truth documents (P2-3)
  error           String?
  cancelRequested Boolean           @default(false)
  // v2.5.0 continuation engine: cross-slice resume state + instance lease
  checkpoint      String? // JSON EngineCheckpoint — phase cursor + volatile ctx state
  leaseUntil      DateTime? // single-run guard across serverless instances
  sliceN          Int               @default(0) // how many 300s slices this run has consumed
  // v3.3 accounts & workspaces (P1-1 / P2-2)
  userId          String? // owning account, null = anonymous
  workspaceId     String? // owning workspace, null = personal
  // v3.4 platform layer
  apiKeyId        String? // which API key started this run (usage attribution + quota)
  watchId         String? // set when this run is a scheduled watch refresh
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?
  events          ActivityEvent[]
  sources         Source[]
  sections        ResearchSection[]
  owner           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace       Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  apiKey          ApiKey?           @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  watch           Watch?            @relation(fields: [watchId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([userId, updatedAt])
  @@index([workspaceId, updatedAt])
  @@index([apiKeyId, createdAt]) // v3.4: monthly-quota counts
  @@index([watchId])
}

// v3.3 P1-1 — accounts & sync. Passwords hashed with scrypt (node:crypto, no native deps).
model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  // v3.5 email-OTP: null = OTP-only account (created by verifying an email
  // code; signs in with codes, password login unavailable until they register
  // a password). Password accounts keep their hash and can use either method.
  passwordHash String?
  createdAt    DateTime          @default(now())
  sessions     Session[]
  apiKeys      ApiKey[]
  jobs         ResearchJob[]
  owned        Workspace[]       @relation("WorkspaceOwner")
  memberships  WorkspaceMember[]
  webhooks     Webhook[]
  watches      Watch[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid()) // token stored in httpOnly cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// v3.3 P2-2 — team workspaces: shared research library + audit views.
model Workspace {
  id         String            @id @default(cuid())
  name       String
  ownerId    String
  owner      User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  inviteCode String            @unique // share to let teammates join
  createdAt  DateTime          @default(now())
  jobs       ResearchJob[]
  members    WorkspaceMember[]

  @@index([createdAt])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // owner|member
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

// v3.3 P2-3 — public API keys for the verified-report API.
model ApiKey {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String        @default("default")
  prefix       String // first chars of the key, shown in UI
  keyHash      String // sha256 of the full key
  revoked      Boolean       @default(false)
  lastUsedAt   DateTime?
  createdAt    DateTime      @default(now())
  // v3.4 platform layer — per-key authorization + usage caps.
  // v3.9.0: JSON-encoded TEXT (SQLite/D1 has no array columns) — decoded at
  // every read boundary via parseStringArray (src/lib/platform/dbjson.ts);
  // the API surface still speaks real string arrays.
  scopes       String         @default("[\"research:read\",\"research:write\",\"webhooks\",\"watches\"]")
  monthlyLimit Int? // max research runs per calendar month via this key; null = unlimited
  researchJobs ResearchJob[]

  @@index([userId])
}

model ActivityEvent {
  id     String      @id @default(cuid())
  jobId  String
  job    ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seq    Int
  ts     DateTime    @default(now())
  type   String // think|search|read|source|summary|gap|section|draft|critique|error|info|done
  title  String
  detail String?
  model  String?
  meta   String? // JSON
  level  String      @default("normal") // normal|verbose

  @@unique([jobId, seq])
}

model Source {
  id           String      @id @default(cuid())
  jobId        String
  job          ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url          String
  domain       String
  title        String
  snippet      String?
  engine       String
  words        Int         @default(0)
  quality      Int         @default(0)
  used         Boolean     @default(false)
  sectionTitle String?
  round        Int         @default(1)
  createdAt    DateTime    @default(now())

  @@unique([jobId, url])
}

model ResearchSection {
  id        String      @id @default(cuid())
  jobId     String
  job       ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  order     Int
  title     String
  question  String
  status    String      @default("pending") // pending|researching|done
  findings  String?
  draftMd   String?
  queries   String? // JSON string[]
  rounds    Int         @default(0)
  createdAt DateTime    @default(now())
}

model Setting {
  key   String @id
  value String
}

// Read-only share snapshots — keyless sharing that survives server restarts.
// Created from a completed job; the report + sources travel together so the
// evidence panel works for viewers who never ran the research.
model SharedReport {
  id        String   @id // short public share id (code-assigned, "s-<base62>")
  jobId     String   @unique
  threadId  String?
  query     String
  mode      String   @default("research")
  language  String   @default("English")
  preset    String   @default("standard")
  reportMd  String
  stats     String? // JSON — includes the claim-check ledger
  sources   String // JSON [{url,domain,title,snippet,sectionTitle}]
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// v3.4 — WEBHOOKS: signed HTTP callbacks when runs finish.
// HMAC-SHA256 per-hook secret; delivery attempts logged for the owner.
model Webhook {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  url        String
  secret     String // per-hook signing secret (regenerable) — HMAC-SHA256
  // v3.9.0: JSON-encoded TEXT (SQLite/D1) — decoded via parseStringArray;
  // webhooks.ts filters with a quoted-substring `contains`, exact for the
  // fixed WEBHOOK_EVENTS token set.
  events     String            @default("[]")
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id        String   @id @default(cuid())
  webhookId String
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  jobId     String?
  event     String
  ok        Boolean
  status    Int? // HTTP response code
  attempts  Int      @default(1)
  error     String?
  createdAt DateTime @default(now())

  @@index([webhookId, createdAt])
}

// v3.4 — WATCHED RESEARCH: re-run a query on a cadence, alert when the
// verdict/evidence fingerprint changes. Refresh runs carry watchId, so the
// engine's completion hook can compare signatures and fire watch.changed.
model Watch {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  query         String
  preset        String        @default("standard")
  domain        String        @default("general")
  language      String        @default("English")
  court         Boolean       @default(false)
  cadenceDays   Int           @default(7)
  active        Boolean       @default(true)
  lastRunId     String?
  lastVerdict   String? // human summary of the latest outcome
  lastSignature String? // sha256 fingerprint of verdict + evidence set
  lastChangedAt DateTime?
  nextRunAt     DateTime      @default(now())
  createdAt     DateTime      @default(now())
  runs          ResearchJob[]

  @@index([active, nextRunAt])
}

// v3.7 — DURABLE AUTH ATTEMPTS. The in-memory rate limiter is per serverless
// instance (resets on every cold start) and per-IP only, so distributed
// brute-force against ONE account was unthrottled. This table backs the
// per-email lockouts (login 5 fails / 15 min, OTP 10 fails / 15 min) and the
// per-email send cooldown — state that must survive instance recycling.
// Retention: rows older than 24h are swept opportunistically on write.
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String // "login" | "otp" | "otpsend"
  email     String
  createdAt DateTime @default(now())

  @@index([kind, email, createdAt])
}
